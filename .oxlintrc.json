{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "vitest", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "off"
  },
  "ignorePatterns": ["dist/**", "coverage/**", "src-tauri/target/**"],
  "env": {
    "builtin": true
  }
}
